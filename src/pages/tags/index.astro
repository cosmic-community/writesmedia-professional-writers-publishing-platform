---
// src/pages/tags/index.astro
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getAllTags } from '@/lib/cosmic';
import type { Tag } from '@/types';

const tags = await getAllTags() as Tag[];
---

<Layout title="Tags - WritesMedia">
  <Header />
  
  <main class="min-h-screen py-12">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold mb-8">Browse by Tag</h1>
      
      {tags.length === 0 ? (
        <div class="text-center py-12">
          <p class="text-gray-600">No tags found.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {tags.map((tag) => (
            <a
              href={`/tags/${tag.slug}`}
              class="bg-white rounded-lg border border-gray-200 p-6 hover:shadow-lg transition-shadow"
            >
              <h3 class="text-xl font-bold mb-2">
                {tag.metadata?.name || tag.title}
              </h3>
              {tag.metadata?.description && (
                <p class="text-gray-600 text-sm">
                  {tag.metadata.description}
                </p>
              )}
            </a>
          ))}
        </div>
      )}
    </div>
  </main>
  
  <Footer />
</Layout>
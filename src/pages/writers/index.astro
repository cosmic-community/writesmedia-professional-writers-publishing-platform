---
// src/pages/writers/index.astro
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getAllUsers } from '@/lib/cosmic';
import type { User } from '@/types';

const users = await getAllUsers() as User[];
---

<Layout title="Writers - WritesMedia">
  <Header />
  
  <main class="min-h-screen py-12">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold mb-8">Our Writers</h1>
      
      {users.length === 0 ? (
        <div class="text-center py-12">
          <p class="text-gray-600">No writers found.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {users.map((user) => (
            <a
              href={`/writers/${user.slug}`}
              class="bg-white rounded-lg border border-gray-200 p-6 hover:shadow-lg transition-shadow"
            >
              <div class="flex items-start space-x-4">
                {user.metadata?.avatar && (
                  <img
                    src={`${user.metadata.avatar.imgix_url}?w=128&h=128&fit=crop&auto=format,compress`}
                    alt={user.title}
                    class="w-16 h-16 rounded-full"
                    width="64"
                    height="64"
                  />
                )}
                
                <div class="flex-1">
                  <div class="flex items-center space-x-2 mb-1">
                    <h3 class="font-bold text-lg">
                      {user.metadata?.name || user.title}
                    </h3>
                    {user.metadata?.verified && (
                      <svg class="w-5 h-5 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                      </svg>
                    )}
                  </div>
                  
                  {user.metadata?.username && (
                    <p class="text-sm text-gray-500 mb-2">
                      @{user.metadata.username}
                    </p>
                  )}
                  
                  {user.metadata?.bio && (
                    <p class="text-sm text-gray-600 line-clamp-2">
                      {user.metadata.bio}
                    </p>
                  )}
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </main>
  
  <Footer />
</Layout>
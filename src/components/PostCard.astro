---
// src/components/PostCard.astro
import type { Post } from '@/types';
import { getAuthor } from '@/types';

export interface Props {
  post: Post;
}

const { post } = Astro.props;

const author = getAuthor(post);
const coverImage = post.metadata?.cover_image;
const contentType = post.metadata?.content_type;
const synopsis = post.metadata?.synopsis;
const readCount = post.metadata?.read_count || 0;
const likeCount = post.metadata?.like_count || 0;
---

<article class="bg-white rounded-lg overflow-hidden border border-gray-200 hover:shadow-lg transition-shadow">
  {coverImage && (
    <a href={`/posts/${post.slug}`}>
      <img
        src={`${coverImage.imgix_url}?w=800&h=400&fit=crop&auto=format,compress`}
        alt={post.title}
        class="w-full h-48 object-cover"
        width="400"
        height="200"
      />
    </a>
  )}
  
  <div class="p-6">
    {contentType && (
      <div class="mb-2">
        <span class="inline-block px-3 py-1 text-xs font-semibold text-primary bg-secondary rounded-full">
          {contentType.value}
        </span>
      </div>
    )}
    
    <a href={`/posts/${post.slug}`} class="block group">
      <h3 class="text-xl font-bold mb-2 group-hover:text-primary transition-colors">
        {post.title}
      </h3>
    </a>
    
    {synopsis && (
      <p class="text-gray-600 text-sm mb-4 line-clamp-2">
        {synopsis}
      </p>
    )}
    
    <div class="flex items-center justify-between pt-4 border-t border-gray-100">
      {author && (
        <a href={`/writers/${author.slug}`} class="flex items-center space-x-2 hover:opacity-80">
          {author.metadata?.avatar && (
            <img
              src={`${author.metadata.avatar.imgix_url}?w=64&h=64&fit=crop&auto=format,compress`}
              alt={author.title}
              class="w-8 h-8 rounded-full"
              width="32"
              height="32"
            />
          )}
          <span class="text-sm font-medium text-gray-700">
            {author.metadata?.name || author.title}
          </span>
        </a>
      )}
      
      <div class="flex items-center space-x-4 text-sm text-gray-500">
        <span class="flex items-center">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          {readCount}
        </span>
        <span class="flex items-center">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
          {likeCount}
        </span>
      </div>
    </div>
  </div>
</article>